# Copy this to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to git!

aws_region       = "us-east-1"
key_pair_name    = "ontorag-key"        # Your AWS key pair name
my_ip            = "YOUR_IP/32"         # Your public IP (find at whatismyip.com)
cerebras_api_key = "csk-xxxxxxxxxxxxx"  # Your Cerebras API key
neo4j_password   = "your-secure-password-here"
